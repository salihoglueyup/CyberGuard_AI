# CyberGuard AI - .gitignore
# Hassas bilgiler ve büyük dosyalar hariç tutuluyor

# ============================================
# Hassas Bilgiler (API Keys, Secrets)
# ============================================
.env
.env.local
.env.production
.env.*.local
config/secrets.yaml
config/production.yaml

# ============================================
# Çok Büyük Dosyalar (GitHub 100MB limit)
# ============================================
src/database/cyberguard.db

# Büyük veri dosyaları (Kaggle'dan indirilebilir)
data/raw/
data/processed/
*.csv.gz
*.parquet

# Log dosyaları
logs/

# ============================================
# Python Cache
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ============================================
# Virtual Environment
# ============================================
.venv/
venv/
ENV/
env/

# ============================================
# Node Modules
# ============================================
node_modules/

# ============================================
# IDE ve Editor
# ============================================
.idea/
.vscode/
*.swp
*.swo
*~

# ============================================
# OS Files
# ============================================
.DS_Store
Thumbs.db
Desktop.ini

# ============================================
# Build/Dist
# ============================================
build/
dist/
*.egg-info/

# ============================================
# Test/Coverage
# ============================================
.pytest_cache/
.coverage
htmlcov/
.tox/

# ============================================
# Geçici Dosyalar
# ============================================
*.tmp
*.temp
*.bak

# ============================================
# Claude Code / Yerel Ajan Ayarları
# ============================================
.claude/

# ============================================
# Hassas / Çalışma-Zamanı Veri Dosyaları
# (Kullanıcılar, oturumlar, runtime state - .example şablonları repo'da)
# ============================================
data/users.json
data/sessions.json
data/incidents.json
data/gan_generated.json
data/siem_config.json
data/honeypots.json
data/honeypot_captures.json
data/threat_hunts.json
data/geoip_cache.db
app/data/*.json

# Otomatik üretilen raporlar
endpoints_report.txt

# Office geçici / kilit dosyaları
~$*
*.tmp.docx
